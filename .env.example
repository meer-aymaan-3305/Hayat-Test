APP_ENV=development
LOG_LEVEL=INFO
HAYAT_API_URL=http://127.0.0.1:8000

GROQ_API_KEY=replace_with_server_only_groq_key
GROQ_MODEL=allam-2-7b

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_supabase_key

# Comma-separated browser origins. Keep empty until the frontend origin is known.
ALLOWED_ORIGINS=
MAX_REQUEST_CHARS=8000

# Leave unset until the project owner supplies the selected SMS provider.
SMS_PROVIDER_NAME=
SMS_PROVIDER_API_URL=
SMS_PROVIDER_API_KEY=

# Firebase Authentication phone provider (server-side configuration).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# JSON service-account credentials, supplied through a secret manager only.
FIREBASE_SERVICE_ACCOUNT_JSON=
