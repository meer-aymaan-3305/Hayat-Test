APP_ENV=development
LOG_LEVEL=INFO
HAYAT_API_URL=http://127.0.0.1:2005

# Must match JWT_SYSTEM_SECRET in trawellcare-admin-be and trawellcare-bff.
# Without it every request except /health and /docs is refused.
JWT_SYSTEM_SECRET=

GROQ_API_KEY=replace_with_server_only_groq_key
GROQ_MODEL=allam-2-7b
GROQ_TEMPERATURE=0.2
GROQ_MAX_TOKENS=160
GROQ_TIMEOUT_SECONDS=20

# Off until the AI passes safety testing. See docs/HAYAT_POLICY_REGISTER.md in
# the workspace root. Website visitors get scripted replies while it is off.
MEDICAL_AI_REPLIES=false
# Shadow mode: while MEDICAL_AI_REPLIES is off, also ask the AI what it would
# have said, and only log it. Visitors still get the scripted reply. Needs
# GROQ_API_KEY. At most 20 calls a minute. Review the "hayat.shadow" log lines.
MEDICAL_AI_SHADOW=false

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace_with_server_only_supabase_key

# Comma-separated browser origins. Keep empty until the frontend origin is known.
ALLOWED_ORIGINS=
MAX_REQUEST_CHARS=8000

# Leave unset until the project owner supplies the selected SMS provider.
SMS_PROVIDER_NAME=
SMS_PROVIDER_API_URL=
SMS_PROVIDER_API_KEY=

# Firebase Authentication phone provider (server-side configuration).
FIREBASE_API_KEY=
FIREBASE_PROJECT_ID=
# JSON service-account credentials, supplied through a secret manager only.
FIREBASE_SERVICE_ACCOUNT_JSON=

# Voice (Groq Whisper STT + PlayAI TTS; reuses GROQ_API_KEY, fails closed without it)
GROQ_STT_MODEL=whisper-large-v3
GROQ_STT_LANGUAGE=
GROQ_TTS_MODEL_EN=canopylabs/orpheus-v1-english
GROQ_TTS_MODEL_AR=canopylabs/orpheus-arabic-saudi
GROQ_TTS_VOICE_EN=hannah
GROQ_TTS_VOICE_AR=noura

# Approved company-knowledge ingestion (BFF/service-token only; never visitor docs)
KNOWLEDGE_DIR=data/knowledge
MAX_UPLOAD_MB=10

# Visitor attachments (PDF/DOCX/TXT, max 5 per conversation, stored privately and
# never read, indexed or sent to the CRM or Groq). Off by default; turn on only
# with compliance approval. MAX_UPLOAD_MB above also caps each attachment.
VISITOR_ATTACHMENTS_ENABLED=false
ATTACHMENTS_DIR=data/attachments
# Days to keep attachments before they are deleted (0 = keep forever).
ATTACHMENT_RETENTION_DAYS=90

# Guided intake: after the category, Hayat asks budget, travellers, accommodation or
# reports, then name, phone (OTP), optional email and callback time, then consent.
EXTENDED_INTAKE=false
# Lets Hayat ask for an existing diagnosis (owner decision; the Guardrail Document
# otherwise forbids collecting clinical details). Stored only for the Medical Advisor.
COLLECT_DIAGNOSIS=false
# Local testing only (APP_ENV development/test): no SMS, the OTP code is always 123456.
DEV_FAKE_OTP=false

# Model that reads each visitor message (question vs answer vs wants a human, plus the
# details it contains). Use a different model from GROQ_MODEL so the two do not share one
# rate limit bucket.
GROQ_ANALYSIS_MODEL=qwen/qwen3.8-27b
GROQ_TTS_STYLE_EN=warm
