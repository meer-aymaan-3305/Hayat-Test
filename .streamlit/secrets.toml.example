# Paste the real values into Streamlit Cloud: App -> Settings -> Secrets.
# Never commit a real secrets.toml (it is git-ignored).

# Required
GROQ_API_KEY = "gsk_..."
APP_PASSWORD = "choose-a-team-password"

# Where Hayat sends visitors to create a free account or log in (use your real page).
# Without it Hayat only says the option is on the trawellcare website and shares no link.
SIGNUP_URL = "https://www.trawellcare.com/login"
# Optional: the support channel Hayat mentions when someone wants a person right now.
# SUPPORT_CONTACT = "support@your-site.example"

# Optional model settings
GROQ_MODEL = "qwen/qwen3.8-27b"
GROQ_ANALYSIS_MODEL = "qwen/qwen3.8-27b"
GROQ_FALLBACK_MODELS = "openai/gpt-oss-120b,openai/gpt-oss-20b"

# Backup AI provider, used automatically when Groq is rate limited (recommended).
# Free Gemini key: https://aistudio.google.com/apikey
# LLM_FALLBACK_BASE_URL = "https://generativelanguage.googleapis.com/v1beta/openai"
# LLM_FALLBACK_API_KEY = "AIza..."
# LLM_FALLBACK_MODEL = "gemini-2.5-flash"

# Optional voice settings (defaults shown)
# GROQ_STT_MODEL = "whisper-large-v3"
# GROQ_TTS_VOICE_EN = "hannah"
# GROQ_TTS_VOICE_AR = "noura"
# GROQ_TTS_STYLE_EN = "warm"

# Optional: keep conversations in Supabase instead of memory (memory is the default
# and is wiped on restart, which is what you want for a throwaway team test).
# USE_SUPABASE = "true"
# SUPABASE_URL = "https://xxxx.supabase.co"
# SUPABASE_SERVICE_ROLE_KEY = "..."

# Leave unset: Policy Addendum 1.1 gates real contact sharing with coordinators.
# POLICY_ADDENDUM_1_1_APPROVED = "false"
